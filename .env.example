PUBLIC_APP_URL=https://seu-dominio.com.br

# Obrigatório em produção. Em desenvolvimento/teste, deixe vazio somente quando usar modo efêmero.
DATABASE_URL=
JWT_SECRET=

# Chave dedicada para criptografia de segredos persistidos (ex.: token do WhatsApp em appSecrets),
# desacoplada de JWT_SECRET. Recomendado em produção. Enquanto ausente, segredos novos e existentes
# usam uma chave derivada de JWT_SECRET (fallback legado) — ver README.md para o plano de migração.
# Rotacionar JWT_SECRET sem configurar esta chave antes torna segredos legados ilegíveis.
APP_SECRETS_ENCRYPTION_KEY=

# Permite fallback em memória apenas fora de produção. Não use em deploy real.
ALLOW_MEMORY_PERSISTENCE=false

# OpenAI backend-only. Never expose OPENAI_* values through VITE_* variables or client-side code.
OPENAI_API_KEY=
# Quando não vazio, o resolvedor trata automaticamente o endpoint como openai-compatible.
# Nenhuma operação é assumida; liste somente operações efetivamente validadas abaixo.
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TRANSCRIPTION_MODEL=whisper-1
OPENAI_IMAGE_MODEL=gpt-image-1

# Legado (mantido por compatibilidade — não remover). Seleciona o provider global
# para MEAL_TEXT/MEAL_VISION quando a capacidade correspondente não usa AI_MEAL_*.
# "openai" (padrão) ou "gemini".
AI_VISION_PROVIDER=openai
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Registro de capacidades de IA (#921): resolvedor por capacidade, opcional.
# Capacidades: MEAL_TEXT, MEAL_VISION, WHATSAPP_INTENT, QUESTION, NUTRITION_SEARCH,
# EMBEDDING, TRANSCRIPTION, IMAGE_ANNOTATION, FOOD_CLASSIFICATION (reservada, sem
# consumidor independente — ver #922). QUESTION exige text e web_search;
# NUTRITION_SEARCH exige text, structured_output e web_search; EMBEDDING exige
# embeddings; TRANSCRIPTION exige transcription.
# Migradas em #922: MEAL_TEXT, MEAL_VISION e WHATSAPP_INTENT. Migradas em #923:
# QUESTION, NUTRITION_SEARCH e EMBEDDING. Migrada em #924: TRANSCRIPTION. As demais
# capacidades permanecem nos consumidores previstos pelas subissues seguintes.
#
# Precedência por capacidade: AI_<CAPABILITY>_* (novo) > variável legada
# compatível > default equivalente ao baseline. Para texto/visão, OPENAI_MODEL
# ou GEMINI_MODEL é escolhido conforme o provider. Para transcrição,
# OPENAI_TRANSCRIPTION_MODEL é o fallback legado e whisper-1 permanece o default.
# O resolvedor nunca infere provider pelo nome do modelo.
#
# Providers conhecidos: openai | gemini | openai-compatible. OPENAI_BASE_URL não
# vazio aplica automaticamente openai-compatible. Nesse modo, apenas operações
# listadas em AI_OPENAI_COMPATIBLE_OPERATIONS são suportadas.
# Operações: text, vision, structured_output, web_search, embeddings,
# transcription, image_generation, image_edit.
AI_OPENAI_COMPATIBLE_OPERATIONS=
#
# AI_<CAPABILITY>_PROVIDER=
# AI_<CAPABILITY>_MODEL=
# AI_<CAPABILITY>_TIMEOUT_MS=
# AI_<CAPABILITY>_MAX_ATTEMPTS=
# AI_<CAPABILITY>_FALLBACK_ENABLED=false
# AI_<CAPABILITY>_FALLBACK_PROVIDER=
# AI_<CAPABILITY>_FALLBACK_MODEL=
# AI_<CAPABILITY>_CROSS_PROVIDER_FALLBACK_ENABLED=false
#
# Fallback é desabilitado por padrão e isolado por capacidade. Provider de
# fallback diferente exige CROSS_PROVIDER_FALLBACK_ENABLED=true fora de produção.
# Em NODE_ENV=production, cross-provider permanece bloqueado fail-closed até o
# benchmark, a revisão de privacidade e o rollout aprovados na issue #927, mesmo
# quando a flag estiver true. Cada provider usa seu próprio modelo; modelo do
# primário não é reutilizado no provider de fallback. Timeout e MAX_ATTEMPTS
# inválidos produzem estado invalid.
#
# Estados disabled/invalid e limites inválidos são bloqueados pelo executor antes
# de qualquer callback. Cada tentativa propaga AbortSignal pelo AiProvider até o
# SDK; retry/fallback só começa depois de a chamada anterior encerrar. Se uma
# chamada expirada ignorar o sinal, a execução falha fechado sem outro provider.
# Estados: ready | degraded | disabled | invalid.
# Diagnósticos nunca expõem segredo, payload, prompt ou mídia. Uso de variável
# legada inclui aviso [deprecated] no array diagnostics.
#
# Exemplos das capacidades migradas em #922 (fallback continua desabilitado):
# AI_MEAL_TEXT_PROVIDER=openai
# AI_MEAL_TEXT_MODEL=gpt-4.1-mini
# AI_MEAL_VISION_PROVIDER=gemini
# AI_MEAL_VISION_MODEL=gemini-2.5-flash
# AI_WHATSAPP_INTENT_PROVIDER=openai
# AI_WHATSAPP_INTENT_MODEL=gpt-4.1-mini
#
# Compatibilidade legada de intenção, somente para provider OpenAI/OpenAI-compatible.
# Precedência de modelo: OPENAI_WHATSAPP_INTENT_MODEL > OPENAI_TEXT_MODEL >
# modelo legado/default resolvido para o provider. Sem overrides de timeout ou
# tentativas, preserva o baseline de 8000 ms e 1 retry (2 chamadas primárias).
# OPENAI_WHATSAPP_INTENT_MODEL=gpt-4.1-mini
# OPENAI_TEXT_MODEL=gpt-4.1-mini
# OPENAI_WHATSAPP_INTENT_TIMEOUT_MS=8000
# OPENAI_WHATSAPP_INTENT_RETRIES=1
#
# Exemplos das capacidades migradas em #923 (fallback continua desabilitado):
# AI_QUESTION_PROVIDER=openai
# AI_QUESTION_MODEL=gpt-4.1-mini
# Modos: auto | disabled. auto oferece a ferramenta web_search sem obrigar o
# uso; disabled não envia ferramenta ao provider. Valores desconhecidos falham
# de forma fechada como disabled; off permanece aceito como alias legado.
# AI_QUESTION_WEB_SEARCH_MODE=auto
# AI_QUESTION_FALLBACK_ENABLED=false
# AI_QUESTION_FALLBACK_PROVIDER=gemini
# AI_QUESTION_FALLBACK_MODEL=gemini-2.5-flash
# AI_QUESTION_CROSS_PROVIDER_FALLBACK_ENABLED=false
#
# AI_NUTRITION_SEARCH_PROVIDER=openai
# AI_NUTRITION_SEARCH_MODEL=gpt-4.1-mini
# AI_NUTRITION_SEARCH_FALLBACK_ENABLED=false
# Gemini 2.5 suporta Structured Output e Google Search separadamente, mas não
# a combinação na mesma chamada. Para Gemini, NUTRITION_SEARCH exige um modelo
# Gemini 3 explicitamente aprovado; nenhum modelo/default é promovido antes da #927.
# AI_NUTRITION_SEARCH_FALLBACK_PROVIDER=gemini
# AI_NUTRITION_SEARCH_FALLBACK_MODEL=gemini-3.1-pro-preview
# AI_NUTRITION_SEARCH_CROSS_PROVIDER_FALLBACK_ENABLED=false
#
# EMBEDDING preserva text-embedding-3-small da OpenAI como default. Gemini não
# anuncia a operação embeddings, então não é elegível como fallback mesmo com
# CROSS_PROVIDER_FALLBACK_ENABLED=true.
# AI_EMBEDDING_PROVIDER=openai
# AI_EMBEDDING_MODEL=text-embedding-3-small
# AI_EMBEDDING_FALLBACK_ENABLED=false
# AI_EMBEDDING_FALLBACK_PROVIDER=openai
# AI_EMBEDDING_FALLBACK_MODEL=text-embedding-3-small
# AI_EMBEDDING_CROSS_PROVIDER_FALLBACK_ENABLED=false
#
# TRANSCRIPTION usa o executor comum desde #924. whisper-1 permanece o default
# e fornece segmentos quando o provider retornar verbose_json. Modelos GPT-4o
# de transcrição retornam json e podem não fornecer segmentos; consumidores usam
# o texto como contrato mínimo. Fallback continua desabilitado por padrão.
# AI_TRANSCRIPTION_PROVIDER=openai
# AI_TRANSCRIPTION_MODEL=whisper-1
# AI_TRANSCRIPTION_TIMEOUT_MS=30000
# AI_TRANSCRIPTION_MAX_ATTEMPTS=1
# AI_TRANSCRIPTION_FALLBACK_ENABLED=false
# AI_TRANSCRIPTION_FALLBACK_PROVIDER=openai
# AI_TRANSCRIPTION_FALLBACK_MODEL=gpt-4o-mini-transcribe
# AI_TRANSCRIPTION_CROSS_PROVIDER_FALLBACK_ENABLED=false

# WhatsApp oficial da solução. Um único número/canal recebe e envia todas as mensagens.
WHATSAPP_PHONE_NUMBER=5511000000000
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=

# Rollout do contexto conversacional persistente do WhatsApp.
# O padrão seguro, quando estas variáveis não existem, é write_only com 0% de leitura persistente.
# Modos: legacy | write_only | shadow | persistent. Percentual: inteiro entre 0 e 100.
WHATSAPP_CONTEXT_READ_MODE=write_only
WHATSAPP_CONTEXT_ROLLOUT_PERCENT=0
# Em shadow, executa comparação adicional de intenção/alvo somente na amostra elegível.
# Mantém false fora de janelas controladas por causa do custo adicional de classificação.
WHATSAPP_CONTEXT_SHADOW_COMPARE_INTENT=false
# Sobrescritas opcionais por fluxo: TEXT, IMAGE, AUDIO e MULTIMODAL.
# WHATSAPP_CONTEXT_READ_MODE_TEXT=shadow
# WHATSAPP_CONTEXT_ROLLOUT_PERCENT_TEXT=0
# WHATSAPP_CONTEXT_READ_MODE_IMAGE=write_only
# WHATSAPP_CONTEXT_ROLLOUT_PERCENT_IMAGE=0
# WHATSAPP_CONTEXT_READ_MODE_AUDIO=write_only
# WHATSAPP_CONTEXT_ROLLOUT_PERCENT_AUDIO=0
# WHATSAPP_CONTEXT_READ_MODE_MULTIMODAL=write_only
# WHATSAPP_CONTEXT_ROLLOUT_PERCENT_MULTIMODAL=0

# Strava OAuth e sincronização de exercícios.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=
STRAVA_APP_REDIRECT_BASE_URL=
# Use um número para limitar chamadas de detalhe por sync, ou "all" para buscar todas as elegíveis.
STRAVA_MAX_ACTIVITY_DETAIL_REQUESTS_PER_SYNC=5
