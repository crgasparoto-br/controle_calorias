PUBLIC_APP_URL=https://seu-dominio.com.br

# Obrigatório em produção. Em desenvolvimento/teste, deixe vazio somente quando usar modo efêmero.
DATABASE_URL=
JWT_SECRET=

# Chave dedicada para criptografia de segredos persistidos (ex.: token do WhatsApp em appSecrets),
# desacoplada de JWT_SECRET. Recomendado em produção. Enquanto ausente, segredos novos e existentes
# usam uma chave derivada de JWT_SECRET (fallback legado) — ver README.md para o plano de migração.
# Rotacionar JWT_SECRET sem configurar esta chave antes torna segredos legados ilegíveis.
APP_SECRETS_ENCRYPTION_KEY=

# Permite fallback em memória apenas fora de produção. Não use em deploy real.
ALLOW_MEMORY_PERSISTENCE=false

# OpenAI backend-only. Never expose OPENAI_* values through VITE_* variables or client-side code.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TRANSCRIPTION_MODEL=whisper-1
OPENAI_IMAGE_MODEL=gpt-image-1

# Legado (mantido por compatibilidade — não remover). Seleciona o provider global
# para MEAL_TEXT/MEAL_VISION quando a capacidade correspondente não usa AI_MEAL_*.
# "openai" (padrão) ou "gemini".
AI_VISION_PROVIDER=openai
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Registro de capacidades de IA (#921): resolvedor por capacidade, opcional.
# Capacidades: MEAL_TEXT, MEAL_VISION, WHATSAPP_INTENT, QUESTION, NUTRITION_SEARCH,
# EMBEDDING, TRANSCRIPTION, IMAGE_ANNOTATION, FOOD_CLASSIFICATION (reservada, sem
# consumidor ainda — ver #922). Nenhum consumidor foi migrado para este resolvedor
# nesta issue; apenas o SDK do Gemini (@google/genai) foi migrado.
#
# Precedência por capacidade: AI_<CAPABILITY>_* (novo) > variável legada
# compatível (ex.: AI_VISION_PROVIDER, OPENAI_MODEL) > default equivalente ao
# baseline (OpenAI). O resolvedor nunca infere provider pelo nome do modelo.
# Providers conhecidos: openai | gemini | openai-compatible (para
# OPENAI_BASE_URL apontando a um endpoint compatível — nesse caso, apenas as
# operações listadas em AI_OPENAI_COMPATIBLE_OPERATIONS são consideradas
# suportadas; nada é assumido por padrão).
#
# AI_<CAPABILITY>_PROVIDER=
# AI_<CAPABILITY>_MODEL=
# AI_<CAPABILITY>_TIMEOUT_MS=
# AI_<CAPABILITY>_MAX_ATTEMPTS=
# AI_<CAPABILITY>_FALLBACK_ENABLED=false
# AI_<CAPABILITY>_FALLBACK_PROVIDER=
# AI_<CAPABILITY>_FALLBACK_MODEL=
# AI_<CAPABILITY>_CROSS_PROVIDER_FALLBACK_ENABLED=false
#
# Fallback é desabilitado por padrão em toda capacidade. Habilitar fallback em
# uma capacidade nunca afeta outra. Se AI_<CAPABILITY>_FALLBACK_PROVIDER for
# diferente do provider primário, AI_<CAPABILITY>_CROSS_PROVIDER_FALLBACK_ENABLED
# precisa estar "true" explicitamente; caso contrário a capacidade fica em
# estado "degraded" (primário continua funcionando, fallback não é elegível) e
# nenhum dado é enviado ao segundo provider. Estados possíveis por capacidade:
# ready | degraded | disabled | invalid. Diagnósticos são sempre sanitizados
# (nunca expõem segredo, payload, prompt ou mídia). Resolver por variável
# legada emite aviso de depreciação (log), nunca exception.
# AI_OPENAI_COMPATIBLE_OPERATIONS=
#
# Exemplo (não habilitado por padrão):
# AI_QUESTION_PROVIDER=openai
# AI_QUESTION_FALLBACK_ENABLED=false

# WhatsApp oficial da solução. Um único número/canal recebe e envia todas as mensagens.
WHATSAPP_PHONE_NUMBER=5511000000000
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=

# Rollout do contexto conversacional persistente do WhatsApp.
# O padrão seguro, quando estas variáveis não existem, é write_only com 0% de leitura persistente.
# Modos: legacy | write_only | shadow | persistent. Percentual: inteiro entre 0 e 100.
WHATSAPP_CONTEXT_READ_MODE=write_only
WHATSAPP_CONTEXT_ROLLOUT_PERCENT=0
# Em shadow, executa comparação adicional de intenção/alvo somente na amostra elegível.
# Mantém false fora de janelas controladas por causa do custo adicional de classificação.
WHATSAPP_CONTEXT_SHADOW_COMPARE_INTENT=false
# Sobrescritas opcionais por fluxo: TEXT, IMAGE, AUDIO e MULTIMODAL.
# WHATSAPP_CONTEXT_READ_MODE_TEXT=shadow
# WHATSAPP_CONTEXT_ROLLOUT_PERCENT_TEXT=0
# WHATSAPP_CONTEXT_READ_MODE_IMAGE=write_only
# WHATSAPP_CONTEXT_ROLLOUT_PERCENT_IMAGE=0
# WHATSAPP_CONTEXT_READ_MODE_AUDIO=write_only
# WHATSAPP_CONTEXT_ROLLOUT_PERCENT_AUDIO=0
# WHATSAPP_CONTEXT_READ_MODE_MULTIMODAL=write_only
# WHATSAPP_CONTEXT_ROLLOUT_PERCENT_MULTIMODAL=0

# Strava OAuth e sincronização de exercícios.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=
STRAVA_APP_REDIRECT_BASE_URL=
# Use um número para limitar chamadas de detalhe por sync, ou "all" para buscar todas as elegíveis.
STRAVA_MAX_ACTIVITY_DETAIL_REQUESTS_PER_SYNC=5
