direction: down

antes: "HOJE — fragmentação" {
  direction: right

  entrada_a: "Entrada\ntexto · áudio · imagem" {
    style: { fill: "#eef2ff"; stroke: "#4f46e5" }
  }

  ia_a: "LLM\nprompt monolítico\nfoodName livre" {
    style: { fill: "#fff7ed"; stroke: "#ea580c" }
  }

  lexico: "Camada léxica\n(token sets · regex\n· constantes)" {
    style: { fill: "#fef2f2"; stroke: "#dc2626" }
  }

  bases: "6 bases paralelas de alimento" {
    style: { fill: "#fef2f2"; stroke: "#dc2626"; stroke-dash: 3 }
  }

  b1: "foodCatalogReference\n33 itens, em código"
  b2: "tacoCatalog.json\n616 itens, em código"
  b3: "foodCatalog\nbanco"
  b4: "foods governado\n19 itens"
  b5: "constantes curadas\nmussarela · ovo · café"
  b6: "aliases pessoais\nchave = texto"

  canais: "Gates por canal\n66 arquivos" {
    style: { fill: "#fef2f2"; stroke: "#dc2626" }
  }

  ciclo: "CICLO\nbug → PR de 1 alimento\n→ novo if" {
    shape: cylinder
    style: { fill: "#fee2e2"; stroke: "#b91c1c" }
  }

  entrada_a -> ia_a -> lexico -> bases
  bases -> b1
  bases -> b2
  bases -> b3
  bases -> b4
  bases -> b5
  bases -> b6
  b6 -> canais
  canais -> ciclo
  ciclo -> lexico: "mais uma exceção" { style.stroke-dash: 4 }
}

depois: "PROPOSTA — Núcleo de Inteligência Alimentar" {
  direction: right

  entrada_b: "Entrada\ntexto · áudio\nimagem · web" {
    style: { fill: "#eef2ff"; stroke: "#4f46e5" }
  }

  adapt: "Adaptação\nde canal\ntranscrição · OCR" {
    style: { fill: "#f0fdf4"; stroke: "#16a34a" }
  }

  interp: "Interpretação v2 (LLM)\nconceito · categoria\nqualificadores · marca\nalternativas · evidência" {
    style: { fill: "#ecfeff"; stroke: "#0891b2" }
  }

  resolver: "RESOLVEDOR ÚNICO (código)\n1 candidatos · 2 aceitação\n3 quantidade · 4 composição\n5 pendências" {
    style: { fill: "#f0fdf4"; stroke: "#16a34a"; stroke-width: 3 }
  }

  ontologia: "ONTOLOGIA — fonte única" {
    style: { fill: "#eff6ff"; stroke: "#1d4ed8"; stroke-width: 3 }
  }

  c1: "food_concepts\n+ variant_axes"
  c2: "food_products\nSKU · marca"
  c3: "food_references\nTACO · TBCA · rótulo"
  c4: "food_portions\ncanonical · learned"
  c5: "food_aliases\nglobal · user"

  slots: "Clarificação unificada\n4 slots: identity · variant\n· quantity · nutrition" {
    style: { fill: "#fefce8"; stroke: "#ca8a04" }
  }

  aprend: "Aprendizado que compõe\ncorreção → dado → fila\n→ promoção → regressão" {
    style: { fill: "#f5f3ff"; stroke: "#7c3aed" }
  }

  metricas: "Métricas\nresolução direta ≥ 90%\n0 regressão reaberta" {
    style: { fill: "#f8fafc"; stroke: "#475569" }
  }

  entrada_b -> adapt -> interp -> resolver
  resolver -> ontologia
  ontologia -> c1
  ontologia -> c2
  ontologia -> c3
  ontologia -> c4
  ontologia -> c5
  resolver -> slots: "só o que falta"
  slots -> aprend
  aprend -> ontologia: "dado novo" { style.stroke-dash: 4 }
  resolver -> metricas
}