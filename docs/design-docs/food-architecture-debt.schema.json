{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Food architecture debt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "entries"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ruleId",
          "file",
          "fingerprint",
          "reason",
          "owner",
          "issue",
          "createdAt",
          "expiresAt",
          "migrationIssue",
          "retirementIssue"
        ],
        "properties": {
          "ruleId": {
            "type": "string",
            "enum": ["17", "18", "5", "11", "3", "10", "1", "2", "4"]
          },
          "file": {
            "type": "string",
            "minLength": 1
          },
          "fingerprint": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "issue": {
            "type": "integer",
            "minimum": 1
          },
          "createdAt": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "expiresAt": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "migrationIssue": {
            "type": "integer",
            "minimum": 1
          },
          "retirementIssue": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  }
}
